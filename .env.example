# Configure these privately in Render; never commit credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SITE_URL=https://ahernai.com
SITE_GATE_PASSWORD=

# New lead notifications. Use Resend over HTTPS, or SMTP where supported.
LEAD_NOTIFY_TO=mike@ahernai.com
LEAD_NOTIFY_FROM="Ahern AI <hello@ahernai.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# /leads stays disabled until a separate password of 16+ characters is set.
# Username: mike. This is separate from the preview site's access password.
LEADS_DASHBOARD_PASSWORD=

# Use Satori's EXISTING Turso connection for ALL portal records.
# Copy Satori's TURSO_DATABASE_URL / TURSO_AUTH_TOKEN values into these names
# privately on the website service. Website contact storage stays unchanged.
# New portal_* tables are additive; existing Satori tables are not modified.
# Use NODE_ENV=production on Render for Secure session cookies.
SATORI_DATABASE_URL=
SATORI_AUTH_TOKEN=

# Optional server-only per-person calendar configuration. No database URLs here.
# {"mike":{"calendarUrl":"https://...","familyCalendarUrl":"https://..."}}
SATORI_WORKSPACE_CALENDARS_JSON={}

# One-time account provisioning: set privately, run npm run portal:user,
# then remove PORTAL_USER_PASSWORD from that operator environment.
PORTAL_USER_EMAIL=
PORTAL_USER_NAME=
PORTAL_USER_PASSWORD=
PORTAL_USER_WORKSPACE=
PORTAL_USER_ROLE=owner
