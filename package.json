{
  "name": "ahern-ai-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Ahern AI website — Node/Express server with Turso-backed contact form and analytics, static-Markdown blog.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build-satori.js && node scripts/validate-build.js",
    "postinstall": "npm ci --prefix apps/satori --include=dev --ignore-scripts",
    "portal:user": "node scripts/portal-user.js",
    "portal:setup": "node scripts/portal-setup.js",
    "portal:db": "node scripts/portal-db.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "marked": "^13.0.3",
    "nodemailer": "10.0.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
